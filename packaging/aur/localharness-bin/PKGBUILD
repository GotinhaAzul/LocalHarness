# Maintainer: LocalHarness contributors <https://github.com/GotinhaAzul/LocalHarness/issues>
#
# Prebuilt static musl binary from a GitHub release. The release workflow
# renders this file with real sha256sums and attaches it to the release; update
# the SKIP placeholders before pushing to the AUR.
pkgname=localharness-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='Local-first agent harness for coding and security work'
arch=('x86_64' 'aarch64')
url='https://github.com/GotinhaAzul/LocalHarness'
license=('MIT' 'Apache-2.0')
provides=('localharness' 'lh')
conflicts=('localharness')
options=('!strip' '!debug')

source_x86_64=("lh-v${pkgver}-x86_64-unknown-linux-musl.tar.gz::${url}/releases/download/v${pkgver}/lh-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("lh-v${pkgver}-aarch64-unknown-linux-musl.tar.gz::${url}/releases/download/v${pkgver}/lh-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/lh" "${pkgdir}/usr/bin/lh"

    install -Dm644 "${srcdir}/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
    install -Dm644 "${srcdir}/LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
    install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"

    install -Dm644 "${srcdir}/completions/lh.bash" "${pkgdir}/usr/share/bash-completion/completions/lh"
    install -Dm644 "${srcdir}/completions/lh.zsh" "${pkgdir}/usr/share/zsh/site-functions/_lh"
    install -Dm644 "${srcdir}/completions/lh.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/lh.fish"
    install -Dm644 "${srcdir}/man/lh.1" "${pkgdir}/usr/share/man/man1/lh.1"
}
