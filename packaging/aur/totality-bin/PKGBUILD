# Maintainer: Totality contributors <https://github.com/GotinhaAzul/Totality/issues>
#
# Prebuilt static musl binary from a GitHub release. The release workflow
# renders this file with real sha256sums and attaches it to the release; update
# the SKIP placeholders before pushing to the AUR.
pkgname=totality-bin
pkgver=0.2.1
pkgrel=1
pkgdesc='Local-first agent harness for coding and security work'
arch=('x86_64' 'aarch64')
url='https://github.com/GotinhaAzul/Totality'
license=('MIT' 'Apache-2.0')
provides=('totality' 'tot')
conflicts=('totality')
options=('!strip' '!debug')

source_x86_64=("tot-v${pkgver}-x86_64-unknown-linux-musl.tar.gz::${url}/releases/download/v${pkgver}/tot-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("tot-v${pkgver}-aarch64-unknown-linux-musl.tar.gz::${url}/releases/download/v${pkgver}/tot-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/tot" "${pkgdir}/usr/bin/tot"
    ln -s tot "${pkgdir}/usr/bin/totality"

    install -Dm644 "${srcdir}/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
    install -Dm644 "${srcdir}/LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
    install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"

    install -Dm644 "${srcdir}/completions/tot.bash" "${pkgdir}/usr/share/bash-completion/completions/tot"
    install -Dm644 "${srcdir}/completions/tot.zsh" "${pkgdir}/usr/share/zsh/site-functions/_tot"
    install -Dm644 "${srcdir}/completions/tot.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/tot.fish"
    install -Dm644 "${srcdir}/man/tot.1" "${pkgdir}/usr/share/man/man1/tot.1"
}
