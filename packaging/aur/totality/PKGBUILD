# Maintainer: Totality contributors <https://github.com/GotinhaAzul/Totality/issues>
#
# Source package: builds with the distribution Rust toolchain. Update pkgver
# and sha256sums for each release; the release workflow attaches a rendered
# copy with both filled in.
pkgname=totality
pkgver=0.2.0
pkgrel=1
pkgdesc='Local-first agent harness for coding and security work'
arch=('x86_64' 'aarch64')
url='https://github.com/GotinhaAzul/Totality'
license=('MIT' 'Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo' 'rust')
provides=('tot')
conflicts=('totality-bin')
options=('!lto')

source=("totality-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')
_archive_dir="Totality-${pkgver}"

prepare() {
    cd "${srcdir}/${_archive_dir}"
    cargo fetch --locked
}

build() {
    cd "${srcdir}/${_archive_dir}"
    cargo build --release --locked --offline
}

check() {
    cd "${srcdir}/${_archive_dir}"
    cargo test --locked --offline
}

package() {
    cd "${srcdir}/${_archive_dir}"

    install -Dm755 target/release/tot "${pkgdir}/usr/bin/tot"
    ln -s tot "${pkgdir}/usr/bin/totality"

    install -Dm644 LICENSE-MIT "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 THIRD_PARTY_NOTICES.md "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"

    target/release/tot completions bash > tot.bash
    target/release/tot completions zsh > _tot
    target/release/tot completions fish > tot.fish
    target/release/tot man > tot.1
    install -Dm644 tot.bash "${pkgdir}/usr/share/bash-completion/completions/tot"
    install -Dm644 _tot "${pkgdir}/usr/share/zsh/site-functions/_tot"
    install -Dm644 tot.fish "${pkgdir}/usr/share/fish/vendor_completions.d/tot.fish"
    install -Dm644 tot.1 "${pkgdir}/usr/share/man/man1/tot.1"
}
